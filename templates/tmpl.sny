NodeKind::Text -> {{}}

NodeKind::Break -> <br>

NodeKind::Space -> &#32;

NodeKind::Block ->
<div>
	()
</div>

NodeKind::Excerpt ->
<div class="excerpt">
	<span class="excerpt-label">[[excerpt]]</span>
	<a class="excerpt-goto" href="{{}}">(goto)</a>
	()
</div>

NodeKind::ExcerptNested -> <span class="excerpt-nested">{{}}</span>

NodeKind::Math -> <span class="math">()</span>

NodeKind::MathBlock -> <div class="math-display">()</div>

NodeKind::Em -> <em>()</em>

NodeKind::Strong -> <strong>()</strong>

NodeKind::Code -> <code>()</code>

NodeKind::Image -> <img class="img" src="{{}}" alt="()">

NodeKind::Video -> <video class="video" src="{{}}" controls preload="metadata">()</video>

NodeKind::IntLink -> <a class="int-link" href="{{}}">()</a>

NodeKind::ExtLink -> <a class="ext-link" href="{{}}">()</a>

NodeKind::CodeBlock ->
<pre><code class="language-{{}}">()</code></pre>

NodeKind::Heading ->
<h(aux)>()</h(aux)>

NodeKind::Para ->
<p>()</p>

NodeKind::List ->
<ul>
	()
</ul>

NodeKind::OrderedList ->
<ol start="(aux)">
	()
</ol>

NodeKind::Item ->
<li>
	()
</li>

NodeKind::Quote ->
<blockquote>
	()
</blockquote>

NodeKind::Doc ->
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{}}</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
		<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
		<style>
			html {
				--measure: 38rem;
				-webkit-text-size-adjust: 100%;
			}
			body {
				font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
				font-size: 18px;
				line-height: 1.65;
				color: #222;
				background: #fff;
				margin: 0;
				padding: 0;
				text-rendering: optimizeLegibility;
				display: grid;
				grid-template-columns: minmax(0, 18rem) minmax(0, var(--measure)) 12.5rem;
				grid-template-areas: "graph main nav";
				gap: 2.5rem;
				justify-content: center;
			}
			main {
				grid-area: main;
				padding: 2.5rem 1.5rem 6rem;
				min-width: 0;
			}
			h1, h2, h3, h4, h5, h6 {
				line-height: 1.25;
				font-weight: 600;
				letter-spacing: -0.01em;
				margin: 2.5rem 0 1rem;
			}
			h1 {
				font-size: 2rem;
				margin-top: 0;
			}
			h2 {
				font-size: 1.5rem;
			}
			h3 {
				font-size: 1.2rem;
			}
			p {
				margin: 0 0 1.25rem;
			}
			ul, ol {
				margin: 0 0 1.25rem;
				padding-left: 1.5rem;
			}
			li {
				margin: 0.25rem 0;
			}
			li > p {
				margin: 0 0 0.5rem;
			}
			li > ul, li > ol {
				margin: 0.25rem 0 0;
			}
			a {
				color: #0645ad;
				text-decoration: underline;
				text-underline-offset: 0.15em;
			}
			blockquote {
				margin: 1.5rem 0;
				padding-left: 1.25rem;
				border-left: 2px solid #e0e0e0;
				color: #555;
			}
			code, pre {
				font-family: ui-monospace, "SF Mono", Menlo, monospace;
				font-size: 0.9em;
			}
			pre {
				overflow-x: auto;
				padding: 1rem;
				background: #f6f6f4;
				border-radius: 4px;
			}
			pre code {
				font-size: 1em;
				line-height: 1.45;
			}
			.img, .video {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 1.5rem 0;
				border-radius: 4px;
			}
			.excerpt {
				position: relative;
				display: block;
				margin: 1.5rem 0;
				padding: 2.5rem 1.25rem 1rem;
				background: #f5f5f3;
				border-radius: 6px;
				color: inherit;
				text-decoration: none;
			}
			.excerpt-label {
				position: absolute;
				top: 0.9rem;
				left: 1.25rem;
				font-family: ui-monospace, "SF Mono", Menlo, monospace;
				font-size: 0.8rem;
				line-height: 1;
				color: #8a8a85;
			}
			.excerpt-goto {
				position: absolute;
				top: 0.9rem;
				right: 1.25rem;
				font-size: 0.8rem;
				font-style: italic;
				line-height: 1;
				color: #8a8a85;
				text-decoration: none;
			}
			.excerpt:hover .excerpt-goto {
				color: #8a8a85;
			}
			.excerpt-goto:hover {
				color: #8a8a85;
				text-decoration: underline;
			}
			.math-display {
				margin: 1.5rem 0;
				overflow-x: auto;
			}
			.excerpt-nested {
				font-family: ui-monospace, "SF Mono", Menlo, monospace;
				font-size: 0.85em;
				color: #8a8a85;
			}
			.excerpt > :first-child {
				margin-top: 0;
			}
			.excerpt > :last-child {
				margin-bottom: 0;
			}
			hr {
				border: none;
				border-top: 1px solid #e5e5e5;
				margin: 3rem 0;
			}
			.site-nav {
				grid-area: nav;
				position: sticky;
				top: 0;
				align-self: start;
				padding: 2.5rem 0 2rem;
				font-size: 1.125rem;
			}
			.site-nav ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.site-nav li {
				margin: 0 0 0.75rem;
			}
			.site-nav a {
				color: inherit;
				text-decoration: none;
			}
			.site-nav a:hover {
				text-decoration: underline;
			}
			.site-nav-foot {
				position: fixed;
				bottom: 1.5rem;
				right: 1.5rem;
			}
			.site-nav-foot hr {
				margin: 0 0 0.75rem;
			}
			.site-nav-foot p {
				margin: 0;
			}
			#graph {
				grid-area: graph;
				position: sticky;
				top: 0;
				align-self: start;
				padding: 2.5rem 0 2rem 1.5rem;
				height: 100vh;
				box-sizing: border-box;
			}
			#kgraph {
				display: block;
				width: 100%;
				height: 100%;
				background: #fff;
				border: 1px solid #ececec;
				border-radius: 6px;
				cursor: grab;
				touch-action: none;
			}
			#kgraph.kg-panning {
				cursor: grabbing;
			}
			.kg-link {
				stroke: #dcdcdc;
				stroke-width: 0.4;
			}
			.kg-node circle {
				fill: #c4c4c4;
				cursor: pointer;
			}
			.kg-node text {
				font-size: 2.6px;
				fill: #999;
				text-anchor: middle;
				pointer-events: none;
			}
			.kg-node:hover circle {
				fill: #0645ad;
			}
			.kg-node:hover text {
				fill: #222;
			}
			.kg-here circle {
				fill: #0645ad;
			}
			.kg-here text {
				fill: #222;
				font-weight: 600;
			}
			@media (max-width: 73.5rem) {
				body {
					display: block;
				}
				main {
					max-width: var(--measure);
					margin: 0 auto;
					padding-top: 2rem;
				}
				.site-nav {
					position: static;
					max-width: var(--measure);
					margin: 0 auto;
					padding: 1.5rem 1.5rem 0;
				}
				.site-nav ul {
					display: flex;
					flex-wrap: wrap;
					gap: 1.25rem;
				}
				.site-nav li {
					margin: 0;
				}
				.site-nav-foot {
					display: none;
				}
				#graph {
					display: none;
				}
			}
		</style>
	</head>
	<body data-note="{{}}">
		<aside id="graph"><svg id="kgraph"></svg></aside>
		<nav class="site-nav">
			<ul>
				<li><a href="/">home</a></li>
				<li><a href="/pages/projects">projects</a></li>
				<li><a href="/pages/startups">startups</a></li>
				<li><a href="/pages/music">music</a></li>
				<li><a href="/brain/main.html">brain</a></li>
			</ul>
			<div class="site-nav-foot">
				<hr>
				<p>satvikprasad@gatech.edu</p>
			</div>
		</nav>
		<main>
			()
		</main>
		<script>
		window.addEventListener("load", () => {
			if (!window.katex) return;
			document.querySelectorAll(".math, .math-display").forEach(el => {
				katex.render(el.textContent, el, {
					throwOnError: false,
					displayMode: el.classList.contains("math-display"),
				});
			});
		});
		(() => {
			const svg = document.getElementById("kgraph");
			const here = document.body.dataset.note || "";
			const up = "../".repeat((here.match(/\//g) || []).length);
			const NS = "http://www.w3.org/2000/svg";
			const el = (name, attrs) => {
				const e = document.createElementNS(NS, name);
				for (const k in attrs) e.setAttribute(k, attrs[k]);
				return e;
			};
			fetch(up + "kgraph.json").then(r => r.json()).then(g => {
				const N = g.nodes.length;
				if (!N) return;
				const pos = g.nodes.map((n, i) => {
					const a = 2 * Math.PI * i / N;
					return { x: Math.cos(a), y: Math.sin(a) };
				});
				const deg = new Array(N).fill(0);
				for (const [a, b] of g.links) { deg[a]++; deg[b]++; }
				for (let step = 0; step < 400; step++) {
					const fx = new Float64Array(N);
					const fy = new Float64Array(N);
					for (let i = 0; i < N; i++) {
						for (let j = i + 1; j < N; j++) {
							const dx = pos[i].x - pos[j].x;
							const dy = pos[i].y - pos[j].y;
							const f = 0.02 / (dx * dx + dy * dy + 0.001);
							fx[i] += dx * f; fy[i] += dy * f;
							fx[j] -= dx * f; fy[j] -= dy * f;
						}
					}
					for (const [a, b] of g.links) {
						const dx = pos[b].x - pos[a].x;
						const dy = pos[b].y - pos[a].y;
						fx[a] += dx * 0.02; fy[a] += dy * 0.02;
						fx[b] -= dx * 0.02; fy[b] -= dy * 0.02;
					}
					const cool = 0.5 * (1 - step / 400);
					for (let i = 0; i < N; i++) {
						pos[i].x += fx[i] * cool - pos[i].x * 0.002;
						pos[i].y += fy[i] * cool - pos[i].y * 0.002;
					}
				}
				let lo = { x: Infinity, y: Infinity };
				let hi = { x: -Infinity, y: -Infinity };
				for (const p of pos) {
					lo.x = Math.min(lo.x, p.x); hi.x = Math.max(hi.x, p.x);
					lo.y = Math.min(lo.y, p.y); hi.y = Math.max(hi.y, p.y);
				}
				const span = Math.max(hi.x - lo.x, hi.y - lo.y, 0.001);
				const s = 84 / span;
				for (const p of pos) {
					p.x = 50 + (p.x - (lo.x + hi.x) / 2) * s;
					p.y = 50 + (p.y - (lo.y + hi.y) / 2) * s;
				}
				let view = { x: 0, y: 0, w: 112, h: 112 };
				const apply = () => svg.setAttribute("viewBox", view.x + " " + view.y + " " + view.w + " " + view.h);
				const fit = () => {
					const r = svg.getBoundingClientRect();
					const aspect = r.width / Math.max(r.height, 1);
					let w = 112, h = 112 / aspect;
					if (h < 112) { h = 112; w = 112 * aspect; }
					view = { x: 50 - w / 2, y: 50 - h / 2, w: w, h: h };
					apply();
				};
				fit();
				window.addEventListener("resize", fit);
				for (const [a, b] of g.links) {
					svg.appendChild(el("line", { x1: pos[a].x, y1: pos[a].y, x2: pos[b].x, y2: pos[b].y, class: "kg-link" }));
				}
				let dragged = false;
				g.nodes.forEach((n, i) => {
					const cls = n.path === here ? "kg-node kg-here" : "kg-node";
					const grp = el("g", { class: cls, "data-url": up + n.url });
					grp.appendChild(el("circle", { cx: pos[i].x, cy: pos[i].y, r: 1.5 + Math.min(deg[i], 6) * 0.35 }));
					const label = el("text", { x: pos[i].x, y: pos[i].y - 3 });
					label.textContent = n.path.replace(/\.md$/, "").split("/").pop();
					grp.appendChild(label);
					svg.appendChild(grp);
				});
				svg.addEventListener("wheel", (ev) => {
					ev.preventDefault();
					const r = svg.getBoundingClientRect();
					const px = view.x + (ev.clientX - r.left) / Math.max(r.width, 1) * view.w;
					const py = view.y + (ev.clientY - r.top) / Math.max(r.height, 1) * view.h;
					const w = Math.min(600, Math.max(8, view.w * Math.exp(ev.deltaY * 0.002)));
					const k = w / view.w;
					view.x = px - (px - view.x) * k;
					view.y = py - (py - view.y) * k;
					view.w = w;
					view.h *= k;
					apply();
				}, { passive: false });
				let drag = null;
				let hit = null;
				svg.addEventListener("pointerdown", (ev) => {
					drag = { x: ev.clientX, y: ev.clientY, vx: view.x, vy: view.y };
					dragged = false;
					hit = ev.target && ev.target.closest ? ev.target.closest("[data-url]") : null;
					svg.setPointerCapture(ev.pointerId);
					svg.classList.add("kg-panning");
				});
				svg.addEventListener("pointermove", (ev) => {
					if (!drag) return;
					const dx = ev.clientX - drag.x;
					const dy = ev.clientY - drag.y;
					if (Math.abs(dx) + Math.abs(dy) > 3) dragged = true;
					const r = svg.getBoundingClientRect();
					view.x = drag.vx - dx / Math.max(r.width, 1) * view.w;
					view.y = drag.vy - dy / Math.max(r.height, 1) * view.h;
					apply();
				});
				svg.addEventListener("pointerup", (ev) => {
					if (!drag) return;
					drag = null;
					svg.releasePointerCapture(ev.pointerId);
					svg.classList.remove("kg-panning");
					const url = hit && !dragged ? hit.getAttribute("data-url") : null;
					hit = null;
					if (url) window.location.href = url;
				});
			}).catch(() => {});
		})();
		</script>
	</body>
</html>
